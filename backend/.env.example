# --- Gemini (Google AI Studio) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- OMDb (omdbapi.com) ---
# Get a free key at https://www.omdbapi.com/apikey.aspx
# Free tier: 1,000 requests/day.
OMDB_API_KEY=

# --- App ---
ENVIRONMENT=development
# Comma-separated list is NOT supported by pydantic-settings' default list
# parsing from .env — set this as a JSON array string, e.g.:
# CORS_ORIGINS=["http://localhost:5500","https://yourapp.vercel.app"]
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000"]

# --- Database ---
# SQLite for local/MVP. Swap for Postgres in prod, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./now_showing.db

# --- Caching / recommendation tuning ---
RECOMMEND_CACHE_TTL=86400
OMDB_CACHE_TTL=604800
CACHE_MAX_ENTRIES=2000
EXTERNAL_MAX_RETRIES=3
MIN_VALID_RECOMMENDATIONS=4
RECOMMEND_REQUESTED_COUNT=8
